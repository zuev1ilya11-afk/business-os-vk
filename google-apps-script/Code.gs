function backfillAmounts_(o){if(o.original_amount===''||o.original_amount===null||o.original_amount===undefined)o.original_amount=Number(o.amount||0);return o}
function normalizeCompletion_(o){o=backfillAmounts_(o);let base=Number(o.original_amount||0);if(!Number.isFinite(base)||base<0)throw new Error('Некорректная исходная сумма заявки');const unfinished=truthy_(o.uncompleted_work_done)&&o.status==='Выполнена';if(unfinished){o.uncompleted_work_done=true;o.uncompleted_work_description=String(o.uncompleted_work_description||'').trim();o.uncompleted_work_amount=round2_(o.uncompleted_work_amount);if(!o.uncompleted_work_description)throw new Error('Укажите, какие работы не были выполнены');if(!Number.isFinite(Number(o.uncompleted_work_amount))||Number(o.uncompleted_work_amount)<=0)throw new Error('Укажите стоимость невыполненных работ');if(Number(o.uncompleted_work_amount)>base)throw new Error('Сумма вычета не может быть больше суммы заявки')}else{o.uncompleted_work_done=false;o.uncompleted_work_description='';o.uncompleted_work_amount=0}o.amount=round2_(base-Number(o.uncompleted_work_amount||0));return o}
function normalizeExtraWork_(o){const done=truthy_(o.extra_work_done);if(o.status!=='Выполнена'||!done){o.extra_work_done=false;o.extra_work_description='';o.extra_work_amount=0;return o}o.extra_work_done=true;o.extra_work_description=String(o.extra_work_description||'').trim();o.extra_work_amount=round2_(o.extra_work_amount);if(!o.extra_work_description)throw new Error('Укажите, какие были допработы');if(!Number.isFinite(Number(o.extra_work_amount))||Number(o.extra_work_amount)<=0)throw new Error('Укажите сумму допработ');return o}
function createOrder_(u,p){const s=sheet_('Orders'),h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String);const master=masterById_(p.master_vk_id);const original=Number(Object.prototype.hasOwnProperty.call(p,'original_amount')?p.original_amount:p.amount||0);const row={id:nextOrderId_(),created_at:new Date(),status:p.status&&STATUSES.includes(String(p.status))?String(p.status):(p.master_vk_id?'Назначена':'Новая'),client:p.client||'',phone:p.phone||'',address:p.address||'',work:p.work||'',scheduled_date:p.scheduled_date||'',scheduled_time:p.scheduled_time||'',master_vk_id:master?String(master.vk_user_id):'',master_name:master?String(master.full_name):'',original_amount:original,amount:original,source:p.source||'VK',city:p.city||'Москва',comment:p.comment||'',created_by_vk_id:'owner-local',request_id:p.request_id||'',extra_work_done:p.extra_work_done||false,extra_work_description:p.extra_work_description||'',extra_work_amount:Number(p.extra_work_amount||0),uncompleted_work_done:p.uncompleted_work_done||false,uncompleted_work_description:p.uncompleted_work_description||'',uncompleted_work_amount:Number(p.uncompleted_work_amount||0)};normalizeOrder_(row);normalizeCompletion_(row);normalizeExtraWork_(row);applyPayouts_(row);appendObject_(s,h,row);return{ok:true,order:row}}
function updateOrder_(u,p){const s=sheet_('Orders'),d=s.getDataRange().getValues(),h=d[0].map(String),ii=h.indexOf('id'),ri=d.findIndex((r,i)=>i>0&&String(r[ii])===String(p.id));if(ri<1)return{ok:false,error:'ORDER_NOT_FOUND'};const o=backfillAmounts_(rowObject_(h,d[ri]));['status','client','phone','address','work','scheduled_date','scheduled_time','source','city','comment','extra_work_done','extra_work_description','extra_work_amount','uncompleted_work_done','uncompleted_work_description','uncompleted_work_amount'].forEach(k=>{if(Object.prototype.hasOwnProperty.call(p,k))o[k]=p[k]});if(Object.prototype.hasOwnProperty.call(p,'original_amount'))o.original_amount=Number(p.original_amount||0);else if(Object.prototype.hasOwnProperty.call(p,'amount')&&!Object.prototype.hasOwnProperty.call(p,'uncompleted_work_amount'))o.original_amount=Number(p.amount||0);if(Object.prototype.hasOwnProperty.call(p,'master_vk_id')){const m=masterById_(p.master_vk_id);o.master_vk_id=m?String(m.vk_user_id):'';o.master_name=m?String(m.full_name):''}normalizeOrder_(o);normalizeCompletion_(o);normalizeExtraWork_(o);applyPayouts_(o);s.getRange(ri+1,1,1,h.length).setValues([h.map(k=>cellValue_(o[k]))]);return{ok:true,order:o}}
function normalizeOrder_(o){for(const k of ['client','address','work']){o[k]=String(o[k]||'').trim();if(!o[k])throw new Error('Заполните клиента, адрес и работу')}if(!STATUSES.includes(String(o.status)))o.status=o.master_vk_id?'Назначена':'Новая';if(!o.master_vk_id&&o.status==='Назначена')o.status='Новая';if(o.master_vk_id&&o.status==='Новая')o.status='Назначена'}
