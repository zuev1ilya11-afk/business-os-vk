function saveMasterSchedule_(p){const masterId=String(p.master_vk_id||'').trim(),week=String(p.week_start||'').trim(),days=Array.isArray(p.days)?p.days:[];if(!masterId)throw new Error('Не указан мастер');if(!/^\d{4}-\d{2}-\d{2}$/.test(week))throw new Error('Некорректная неделя');if(days.length!==7)throw new Error('Нужно заполнить 7 дней недели');const s=sheet_('MasterSchedule'),data=s.getDataRange().getValues(),h=data[0].map(String),mi=h.indexOf('master_vk_id'),wi=h.indexOf('week_start');for(let i=data.length-1;i>=1;i--){if(String(data[i][mi])===masterId&&String(formatSheetDate_(data[i][wi]))===week)s.deleteRow(i+1)}const now=new Date(),saved=[];days.forEach((d,i)=>{const on=truthy_(d.is_working);const row={master_vk_id:masterId,week_start:week,date:String(d.date||''),weekday:Number(d.weekday||i+1),is_working:on,work_start:on?String(d.work_start||'09:00'):'',work_end:on?String(d.work_end||'18:00'):'',updated_at:now};if(on&&(!/^\d{2}:\d{2}$/.test(row.work_start)||!/^\d{2}:\d{2}$/.test(row.work_end)))throw new Error('Некорректное рабочее время');appendObject_(s,h,row);saved.push(row)});return{ok:true,schedule:saved}}
