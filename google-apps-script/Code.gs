function doGet(e){const cb=safeCallback_(e.parameter.callback||'callback');let lock;try{const action=e.parameter.action||'bootstrap';if(action==='health')return jsonp_(cb,{ok:true,mode:'public-dev',version:'2026-09-12-10'});lock=LockService.getScriptLock();if(!lock.tryLock(10000))return jsonp_(cb,{ok:false,error:'BUSY'});ensureOrderHeaders_();ensureScheduleSheet_();const user={vk_user_id:'owner-local',full_name:'Илья',role:'owner',city:'Москва',is_active:true};const p=parsePayload_(e.parameter.payload);let r;if(action==='bootstrap')r=bootstrap_(user);else if(action==='createOrder')r=createOrder_(user,p);else if(action==='updateOrder')r=updateOrder_(user,p);else if(action==='addEmployee')r=addEmployee_(p);else if(action==='updateEmployee')r=updateEmployee_(p);else if(action==='saveMasterSchedule')r=saveMasterSchedule_(p);else r={ok:false,error:'UNKNOWN_ACTION'};return jsonp_(cb,r)}catch(err){return jsonp_(cb,{ok:false,error:String(err&&err.message||err)})}finally{if(lock&&lock.hasLock()){try{SpreadsheetApp.flush()}finally{lock.releaseLock()}}}}
function ss_(){return SpreadsheetApp.openById(SPREADSHEET_ID)}function sheet_(n){const s=ss_().getSheetByName(n);if(!s)throw new Error('Sheet not found: '+n);return s}function rows_(n){const s=sheet_(n),v=s.getDataRange().getValues();if(!v.length)return[];const h=v[0].map(String);return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>rowObject_(h,r))}
