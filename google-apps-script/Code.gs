function addEmployee_(p){const name=String(p.full_name||'').trim();if(!name)throw new Error('Укажите имя сотрудника');const us=sheet_('Users'),uh=us.getRange(1,1,1,us.getLastColumn()).getValues()[0].map(String);const role=['owner','manager','dispatcher','master'].includes(String(p.role))?String(p.role):'master';const id='staff_'+Utilities.getUuid().replace(/-/g,'').slice(0,12);const row={vk_user_id:id,full_name:name,role,city:String(p.city||'Москва').trim()||'Москва',is_active:true,phone:String(p.phone||''),comment:String(p.comment||'')};appendObject_(us,uh,row);if(role==='master')upsertMaster_(row,p);return{ok:true,user:row,master:role==='master'?masterById_(id):null}}
function updateEmployee_(p){const id=String(p.vk_user_id||'');const s=sheet_('Users'),d=s.getDataRange().getValues(),h=d[0].map(String),ii=h.indexOf('vk_user_id'),ri=d.findIndex((r,i)=>i>0&&String(r[ii])===id);if(ri<1)return{ok:false,error:'USER_NOT_FOUND'};const o=rowObject_(h,d[ri]);['full_name','phone','city','role','is_active','comment'].forEach(k=>{if(Object.prototype.hasOwnProperty.call(p,k))o[k]=p[k]});s.getRange(ri+1,1,1,h.length).setValues([h.map(k=>cellValue_(o[k]))]);if(String(o.role)==='master'){if(truthy_(o.is_active))upsertMaster_(o,p);else setMasterActive_(id,false)}return{ok:true,user:o}}
function setMasterActive_(id,on){const s=sheet_('Masters'),d=s.getDataRange().getValues();if(!d.length)return;const h=d[0].map(String),ii=h.indexOf('vk_user_id'),ai=h.indexOf('is_active');if(ii<0)return;for(let i=1;i<d.length;i++){if(String(d[i][ii])!==String(id))continue;if(ai>=0)s.getRange(i+1,ai+1).setValue(!!on);break}}
function upsertMaster_(u,p){const s=sheet_('Masters'),d=s.getDataRange().getValues(),h=d[0].map(String),ii=h.indexOf('vk_user_id'),ri=d.findIndex((r,i)=>i>0&&String(r[ii])===String(u.vk_user_id));const m={vk_user_id:String(u.vk_user_id),full_name:u.full_name||'',phone:u.phone||'',city:u.city||'Москва',specialization:String(p.specialization||''),is_active:true,work_start:String(p.work_start||'09:00'),work_end:String(p.work_end||'18:00')};if(ri>0)s.getRange(ri+1,1,1,h.length).setValues([h.map(k=>cellValue_(m[k]))]);else appendObject_(s,h,m)}
function nextOrderId_(){const ids=rows_('Orders').map(x=>Number(String(x.id).replace(/\D/g,''))).filter(Number.isFinite);return'З-'+String((ids.length?Math.max.apply(null,ids):1000)+1)}function appendObject_(s,h,o){s.appendRow(h.map(k=>cellValue_(o[k])))}function tz_(){try{return String(ss_().getSpreadsheetTimeZone()||'Europe/Moscow')}catch(e){return'Europe/Moscow'}}function rowObject_(h,r){return Object.fromEntries(h.map((k,i)=>{let v=r[i];if(v instanceof Date){if(k==='scheduled_date'||k==='week_start'||k==='date')v=Utilities.formatDate(v,tz_(),'yyyy-MM-dd');else if(k==='scheduled_time'||k==='work_start'||k==='work_end')v=Utilities.formatDate(v,tz_(),'HH:mm');else v=Utilities.formatDate(v,'GMT',"yyyy-MM-dd'T'HH:mm:ss'Z'")}return[k,v]}))}function cellValue_(v){return typeof v==='string'&&/^[=+@-]/.test(v)?"'"+v:(v??'')}function truthy_(v){return v===true||String(v).toLowerCase()==='true'||String(v)==='1'||String(v).toLowerCase()==='yes'||String(v).toLowerCase()==='да'}function parsePayload_(raw){if(!raw)return{};try{return JSON.parse(raw)}catch(e){try{return JSON.parse(decodeURIComponent(raw))}catch(_){throw new Error('BAD_PAYLOAD')}}}function safeCallback_(v){return/^[A-Za-z_$][0-9A-Za-z_$\.]*$/.test(v)?v:'callback'}function jsonp_(cb,obj){return ContentService.createTextOutput(cb+'('+JSON.stringify(obj)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}