# Copy only after approval; use the EXISTING database/role/socket.
# No new DB, cloud project, API endpoint or credentials are created here.
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=REPLACE_WITH_EXISTING_DATABASE
PGUSER=REPLACE_WITH_EXISTING_PRIVILEGED_ROLE
PGCONNECT_TIMEOUT=10
# For TCP auth, use a protected existing .pgpass via PGPASSFILE, never this repo.
