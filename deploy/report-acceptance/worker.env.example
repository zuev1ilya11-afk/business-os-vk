# Host systemd unit: /etc/business-os/drive-worker.env, root:root mode 0600.
# Use the verified local HTTP gateway port, or the current public HTTPS origin.
BOS_DRIVE_WORKER_URL=https://homemaster.qd.je/functions/v1/drive-archive-api
BOS_DRIVE_WORKER_KEY=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_THE_EDGE_RUNTIME
# Edge runtime also requires:
# BOS_PUBLIC_URL=https://homemaster.qd.je
# BOS_LEGACY_STORAGE_ORIGINS=<comma-separated exact verified origins from saved reports>
# SUPABASE_URL=<existing internal gateway; do not replace this with the public domain>
# BOS_DRIVE_GAS_URL=<reviewed updated Google Apps Script deployment URL>
