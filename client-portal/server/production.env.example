# Configuration template only. No secrets. Never source this into production unchanged.
NODE_ENV=production
CLIENT_ORIGIN=https://REPLACE_WITH_CLIENT_SUBDOMAIN
CLIENT_STAFF_ORIGINS=["https://REPLACE_WITH_CURRENT_STAFF_ORIGIN"]
CLIENT_API_PORT=4181
# Dedicated trusted PostgreSQL identity; never browser anon/authenticated.
CLIENT_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_SECRET@127.0.0.1:5432/REPLACE_DB
CLIENT_DATABASE_TLS=local
CLIENT_PRIVATE_DIR=/var/lib/business-os-client/private
CLIENT_LEGAL_FILE=/etc/business-os-client/reviewed-documents.json
CLIENT_OTP_PEPPER=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARS
VK_APP_SECRET=REUSE_EXISTING_STAFF_VERIFICATION_SECRET_SECURELY
CLIENT_SMS_TRANSPORT=gateway
CLIENT_SMS_GATEWAY_URL=https://REPLACE_WITH_APPROVED_ADAPTER_ENDPOINT
CLIENT_SMS_GATEWAY_TOKEN=REPLACE_SECURELY
# Provider's contract must guarantee this maximum unit cost. No service purchased.
CLIENT_SMS_DAILY_LIMIT=0
CLIENT_SMS_MAX_PRICE_KOPECKS=0
CLIENT_SMS_DAILY_BUDGET_KOPECKS=0
# Nginx MUST overwrite X-Real-IP, never append the incoming browser header.
CLIENT_TRUSTED_PROXY_ADDRESSES=["127.0.0.1","::1","::ffff:127.0.0.1"]
